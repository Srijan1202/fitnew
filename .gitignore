# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# env & secrets — never commit (§24)
.env
.env.*
!.env.example
# Phase 6.6 alpha: the owner's Firebase defines + LAN API host for the
# alpha build script live here, never in Git (only the .example is tracked).
alpha.env
# Phase 6.7 hosted build: the same kind of file for tool/hosted.ps1.
hosted.env

# Service-account keys. Firebase downloads these as
# <project>-firebase-adminsdk-<hash>.json, which no narrow pattern catches, so
# these are deliberately broad. A leaked admin key is full read/write on every
# user's data.
*service-account*.json
*serviceaccount*.json
*service_account*.json
*-adminsdk-*.json
*firebase-adminsdk*.json
serviceAccountKey.json
google-credentials.json
gcp-credentials.json

# Keys, certs and signing material
*.pem
*.p12
*.pfx
*.key
*.keystore
*.jks
apps/mobile/android/key.properties

# Firebase CLI local state
.firebase/
firebase-debug.log

# Conventional home for local credential files. Anything in here is ignored
# wholesale, so a key dropped in the wrong place still cannot be committed.
.secrets/
**/.secrets/

# flutter / dart
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/build/
apps/mobile/ios/Pods/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/.idea/

# next.js
apps/admin/.next/
apps/admin/out/

# test / coverage
coverage/
.vitest/

# editor / os
.DS_Store
Thumbs.db
.idea/
*.swp

# npm lockfile — this repo uses pnpm (spec §29)
package-lock.json

# IDE
.vscode/

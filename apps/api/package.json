{
  "name": "@fitos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run deps:build && tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "deps:build": "pnpm --filter @fitos/core --filter @fitos/contracts build",
    "build": "pnpm run deps:build && tsc --project tsconfig.build.json",
    "typecheck": "pnpm run deps:build && tsc --noEmit",
    "test": "pnpm run deps:build && vitest run",
    "lint": "eslint src",
    "db:generate": "pnpm build && drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts up",
    "db:rollback": "tsx --env-file-if-exists=.env src/db/migrate.ts down",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:rebuild-volume": "tsx --env-file-if-exists=.env src/db/rebuild-volume.ts",
    "db:rebuild-nutrition": "tsx --env-file-if-exists=.env src/db/rebuild-nutrition.ts",
    "db:rebuild-derived": "tsx --env-file-if-exists=.env src/db/rebuild-derived.ts",
    "db:rebase-mess-nutrition": "tsx --env-file-if-exists=.env src/db/rebase-mess-nutrition.ts",
    "mess:mirror": "tsx --env-file-if-exists=.env src/jobs/mirror-mess.ts",
    "food-seed:build": "pnpm run deps:build && tsx src/scripts/build-food-seed.ts",
    "openapi:export": "pnpm run deps:build && tsx src/scripts/export-openapi.ts",
    "admin:grant": "tsx --env-file-if-exists=.env src/scripts/admin-grant.ts",
    "announce:update": "tsx --env-file-if-exists=.env src/scripts/announce-update.ts",
    "load:test": "pnpm run deps:build && tsx src/scripts/load-test.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fitos/contracts": "workspace:*",
    "@fitos/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "firebase-admin": "14.5.0",
    "pino": "10.4.0",
    "postgres": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fitos/config": "workspace:*",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "2.1.9"
  }
}

{
  "name": "@fitos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run deps:build && tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "deps:build": "pnpm --filter @fitos/core --filter @fitos/contracts build",
    "build": "pnpm run deps:build && tsc --project tsconfig.build.json",
    "typecheck": "pnpm run deps:build && tsc --noEmit",
    "test": "pnpm run deps:build && vitest run",
    "lint": "eslint src",
    "db:generate": "pnpm build && drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts up",
    "db:rollback": "tsx --env-file-if-exists=.env src/db/migrate.ts down",
    "openapi:export": "pnpm run deps:build && tsx src/scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@fastify/rate-limit": "10.2.2",
    "@fastify/swagger": "9.4.2",
    "@fastify/swagger-ui": "5.2.1",
    "@fitos/contracts": "workspace:*",
    "@fitos/core": "workspace:*",
    "drizzle-orm": "0.38.4",
    "fastify": "5.2.1",
    "fastify-plugin": "5.0.1",
    "fastify-type-provider-zod": "4.0.2",
    "firebase-admin": "13.0.2",
    "pino": "9.6.0",
    "postgres": "3.4.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@fitos/config": "workspace:*",
    "@types/node": "22.10.7",
    "drizzle-kit": "0.30.2",
    "eslint": "9.18.0",
    "pino-pretty": "13.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.20.0",
    "vitest": "2.1.9"
  }
}

# Copy to apps/api/.env for local development.
# NEVER commit .env — production reads these from Google Secret Manager (§24).

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Local Postgres from docker/docker-compose.yml.
# Staging/production use a Neon connection string (§8.4) injected via
# Google Secret Manager — never checked in.
DATABASE_URL=postgres://fitos:fitos@localhost:5432/fitos

# ---------------------------------------------------------------- Phase 1 ---
# Firebase Admin, for verifying ID tokens server-side.
#
# FIREBASE_PROJECT_ID is the project id from the Firebase console (not the
# display name) — e.g. fitos-dev, not "FitOS Dev".
#
# GOOGLE_APPLICATION_CREDENTIALS is an absolute path to the service-account
# JSON. Put that file in apps/api/.secrets/ — the whole directory is gitignored
# and excluded from the Docker build context, so a key dropped there cannot be
# committed or baked into an image.
#
#   mkdir -p apps/api/.secrets
#   mv ~/Downloads/<project>-firebase-adminsdk-*.json apps/api/.secrets/firebase-adminsdk.json
#
# A leaked admin key is full read/write on every user's data with no audit
# trail. It is never referenced by a relative path, never logged, and never
# passed to the Flutter app — the app holds only the public Firebase config.
#
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------ Phase 6.6 / 14 AI ---
# FITOS AI runs through this backend (owner B2, ADR-010). Optional: without a
# key the server boots and /v1/ai/* answers 503 "AI is not set up". The key
# is server-side only — never in Flutter, Android resources, the APK or Git.
# Production AI calls must run on a PAID tier: free-tier prompts may be used
# to improve Google's products, and our prompts carry health-adjacent data
# (§19.3). Health Connect data never reaches the model (owner B4).
#
# GEMINI_API_KEY=
# Alpha model (owner decision 2026-09-22): gemini-2.5-flash is not available to
# new keys any more; the name is configuration, nothing in code assumes it.
GEMINI_MODEL=gemini-3.6-flash
AI_TIMEOUT_MS=25000
AI_MAX_OUTPUT_TOKENS=2048

# --------------------------------------------------------------- Phase 6.7 ---
# Hosted (NODE_ENV=production|staging, e.g. Cloud Run) refuses to boot unless
# both are set; development / test keep the Phase 6.6 behaviour when unset.
#
# TRUST_PROXY — how many proxies in front of the API may be believed about the
# client address: a hop count (Cloud Run: verified in Gate 6.7-3), `false`, or
# a comma-separated address / CIDR list. Unset = trust the whole
# X-Forwarded-For chain, which is only safe with no proxy at all (LAN compose).
# TRUST_PROXY=
#
# CONSENT_IP_SALT — at least 16 characters when hosted; from Secret Manager
# (fitos-consent-ip-salt), never this file.
# CONSENT_IP_SALT=

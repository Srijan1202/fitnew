# Copy to .env for local development. NEVER commit .env (§24 — Secret Manager in prod).

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Local Postgres from docker/docker-compose.yml.
# Staging/production use a Neon connection string (§8.4) injected via
# Google Secret Manager — never checked in.
DATABASE_URL=postgres://fitos:fitos@localhost:5432/fitos

# Phase 1. Path to a Firebase service-account JSON, or the JSON itself in prod.
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=

# Phase 14. Model names are env-driven because Gemini names/prices churn (§19.3).
# AI_ENABLED=false
# GEMINI_API_KEY=
# MODEL_FOOD_PARSE=
# MODEL_EXPLAIN=

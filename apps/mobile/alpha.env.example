# FITOS closed alpha — build-time configuration (Phase 6.6 Gate 6).
#
# Copy to apps/mobile/alpha.env and fill in. alpha.env is gitignored; it is
# read only by tool/alpha.ps1 / tool/alpha.sh, which turn every line into a
# --dart-define. Nothing here is a server secret: the Firebase values are the
# project's PUBLIC client config (they identify the project, they authorise
# nothing) and the API host is your PC on your Wi-Fi. The Gemini key is never
# in this file — it stays in docker/.env on the PC.

# Firebase console → Project settings → Your apps → the Android app.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
# Authentication → Sign-in method → Google → Web client ID (the *web* one).
GOOGLE_WEB_CLIENT_ID=

# The PC that runs `docker compose up api`, as the phone reaches it over
# Wi-Fi. `auto` picks this PC's IPv4 on its Wi-Fi / Ethernet adapter at build
# time; or write the address (e.g. 192.168.1.20). The port is the API's.
# Cleartext http is enabled for THIS host only (android/app/build.gradle.kts
# generates the network security config from it).
API_HOST=auto
API_PORT=8080

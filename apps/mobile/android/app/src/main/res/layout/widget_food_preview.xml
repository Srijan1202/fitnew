<?xml version="1.0" encoding="utf-8"?>
<!-- Beta 5.0.1: the widget picker's preview, with sample figures. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:id="@+id/food_label"

        android:text="FOOD LEFT · 1:20 pm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_ink60"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/food_ring"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Calories eaten against your target"
            android:src="@drawable/widget_ring_preview" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/food_value"

        android:text="1,037"
        android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/food_caption"

        android:text="kcal left of 1,737"
        android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="@color/widget_ink60"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/food_protein"

        android:text="Protein 64 g left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />
</LinearLayout>

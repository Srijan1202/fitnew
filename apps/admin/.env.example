# Copy to apps/admin/.env.local (gitignored). Public Firebase client config —
# the same project the app uses (Firebase console → Project settings).
# None of these is a secret; the admin claim is checked by the API.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Usually <project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Where the FITOS API runs (the Docker container on this PC).
FITOS_API_URL=http://localhost:8080

# The admin panel (ADR-022 D1 amendment), on the API server's Caddy. admin.sh
# writes this, with the domain and the release filled in, as
# /opt/fitos/caddy/sites/admin.caddy. The panel is plain files; /api/* goes to
# the serving API container (the fitos_api snippet in the Caddyfile), so the
# browser talks to one origin and the API needs no CORS opening. Every admin
# route checks the admin claim on the API, and every change is audited there.
__DOMAIN__ {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
		# Beta 6.2 (audit S5): enforced since 2026-11-11, after a sign-in and the
		# panel's pages ran report-only with no violation. Google sign-in needs
		# apis.google.com and gstatic (scripts), *.googleapis.com (tokens) and
		# the firebaseapp.com / accounts.google.com frames.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com; frame-src https://*.firebaseapp.com https://accounts.google.com https://apis.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}

	handle /robots.txt {
		respond "User-agent: *
Disallow: /
"
	}

	handle_path /api/* {
		import fitos_api
	}

	handle {
		root * /etc/caddy/admin/releases/__RELEASE__
		@pages not path /_next/static/*
		header @pages Cache-Control "no-cache"
		header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle_errors 404 {
		root * /etc/caddy/admin/releases/__RELEASE__
		rewrite * /404.html
		file_server {
			status 404
		}
	}
}

# FITOS beta (ADR-025): HTTPS for the API, rendered by release.sh.
# Caddy obtains and renews the certificate itself (Let's Encrypt) once the
# domain's A record points at this server. It replaces any X-Forwarded-For a
# client sends with the real address, so the API trusts exactly one hop
# (TRUST_PROXY=1). No access log here: the API logs requests itself, with
# sensitive query values masked (Phase 17).
{
	email __ACME_EMAIL__
	admin localhost:2019
}

# The serving API container. The API site and the admin panel's /api use it,
# so a release (or a rollback) moves both.
(fitos_api) {
	reverse_proxy __UPSTREAM__:8080
}

__API_DOMAIN__ {
	encode zstd gzip
	# Beta 6.2 (audit 2026-11-11 S6): HTTPS only from the first answer on, and no type sniffing.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}
	import fitos_api
}

# More sites, each written by its own deploy: sites/website.caddy (tryfitos.me,
# from the fitos-website repository) and sites/admin.caddy (the admin panel,
# scripts/aws/admin.ps1). No file there is fine (nothing is imported).
import /etc/caddy/sites/*.caddy

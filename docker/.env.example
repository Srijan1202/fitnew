# Copy to docker/.env (gitignored). Read automatically by docker compose.
# Neither value is a secret: the project id is public client config, and the
# filename just points at the key that lives in apps/api/.secrets/.
FIREBASE_PROJECT_ID=fitos-dev-3208b
FIREBASE_KEY_FILE=fitos-dev-3208b-firebase-adminsdk-fbsvc-XXXXXXXXXX.json

# Phase 6.6 — FITOS AI (owner B2). Optional; the server boots without it.
# The key is a secret: docker/.env only, never the image, a client or Git.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Phase 14 (ADR-020). The alpha runs on the free tier by owner decision
# (2026-10-21); move to a paid tier before beta (BACKLOG O7).
# AI_ENABLED=true            # false turns every AI route off (503); the app hides AI
# MODEL_FOOD_PARSE=          # unset: GEMINI_MODEL
# MODEL_EXPLAIN=             # unset: GEMINI_MODEL
# AI_PARSE_PER_HOUR=20       # per user
# AI_EXPLAIN_PER_HOUR=20     # per user
# AI_CHAT_PER_HOUR=60        # per user, model calls
# AI_DAILY_TOKEN_BUDGET=200000  # per user, rolling 24 h, all purposes
